# Serve the Astro static build (`dist/`) with automatic HTTPS.
# Adjust the root path for your VPS layout if needed.

russel.dev, www.russel.dev {
	root * /var/www/landing/dist
	encode gzip zstd

	# Astro emits directory-style routes (e.g. /blog/index.html)
	try_files {path} {path}/ {path}/index.html

	file_server

	# Custom 404 page with a real 404 status
	handle_errors {
		@404 {
			expression `{err.status_code} == 404`
		}
		rewrite @404 /404.html
		file_server
	}

	# Long-cache hashed Astro assets
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
