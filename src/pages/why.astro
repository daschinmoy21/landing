---
import Layout from '../layouts/Layout.astro'
import WhyPage from '../components/ui/WhyPage.jsx'
import DotGrid from '../components/ui/DotGrid.jsx'

const SEO = {
	title: 'Why Russel? — Self-Hosted Deploy Plane vs Containers & Serverless',
	description:
		"Modern deployment forces a tradeoff you shouldn't have to make. How Russel compares on isolation, reproducibility, sovereignty, and speed."
}
---

<Layout title={SEO.title} description={SEO.description} navigation="none" footer="none">
	<div class="why-page">
		<DotGrid
			client:only="react"
			dotSize={4}
			gap={32}
			baseColor="#0c200a"
			activeColor="#1a6b14"
			proximity={130}
			shockRadius={200}
			shockStrength={2.5}
			returnDuration={1.8}
		/>
		<header class="why-top">
			<a class="why-brand" href="/">
				<svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
					<rect x="2" y="2" width="28" height="28" rx="7" fill="none" stroke="currentColor" stroke-width="2"></rect>
					<rect x="12" y="12" width="8" height="8" rx="1.5" fill="currentColor"></rect>
					<path d="M16 2v6M16 24v6M2 16h6M24 16h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path>
				</svg>
				<span>Russel</span>
			</a>
			<nav class="why-nav" aria-label="Page">
				<a href="#compare">Compare</a>
				<a href="#gap">Gap</a>
				<a href="#practice">Practice</a>
				<a href="#decision">Decision</a>
				<a href="/#early-access" class="why-nav-cta">Join waitlist</a>
			</nav>
		</header>

		<WhyPage client:only="react" />

		<footer class="why-foot">
			<a href="/">← Russel</a>
			<span>Self-hosted microVM &amp; container platform</span>
		</footer>
	</div>
</Layout>

<style is:global>
	.why-page {
		--bg: #040803;
		--text: oklch(0.93 0.008 145);
		--muted: oklch(0.72 0.018 145);
		--faint: oklch(0.62 0.016 145);
		--border: oklch(0.18 0.028 145);
		--accent: oklch(0.72 0.17 145);
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
		font-size: 15px;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
		position: relative;
	}

	/* DotGrid background layer — sits behind everything, below the sticky header */
	.why-page .dot-grid {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	.why-page .dot-grid__wrap {
		width: 100%;
		height: 100%;
		position: relative;
	}

	.why-page .dot-grid__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: auto;
	}

	/* All content above DotGrid */
	.why-page .why-page-root,
	.why-page .why-top,
	.why-page .why-foot {
		position: relative;
		z-index: 1;
	}

	.why-page * {
		box-sizing: border-box;
	}

	@media (prefers-reduced-motion: reduce) {
		.why-page *,
		.why-page *::before,
		.why-page *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}

	.why-page a {
		color: inherit;
		text-decoration: none;
	}

	.why-page a:focus-visible,
	.why-page button:focus-visible,
	.why-page [tabindex]:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 4px;
	}

	.why-top {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 28px;
		background: oklch(0.05 0.02 145 / 0.9);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.why-brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-weight: 700;
		font-family: 'Clash-Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		letter-spacing: -0.03em;
		color: var(--accent);
	}

	.why-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 18px;
		font-size: 13px;
		color: var(--muted);
	}

	.why-nav a:hover {
		color: var(--text);
	}

	.why-nav-cta {
		padding: 8px 14px;
		border-radius: 999px;
		background: var(--accent);
		color: #041004 !important;
		font-weight: 600;
	}

	.why-foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px;
		padding: 24px 28px 40px;
		border-top: 1px solid var(--border);
		color: var(--faint);
		font-size: 13px;
		max-width: 1100px;
		margin: 0 auto;
	}

	.why-foot a:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.why-nav a:not(.why-nav-cta) {
			display: none;
		}
	}
</style>
