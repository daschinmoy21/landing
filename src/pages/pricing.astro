---
// src/pages/pricing.astro
import Layout from '../layouts/Layout.astro'
import pricingData from '../data/json-files/pricing.json'

const SEO = {
	title: 'Russel — Pricing Plans',
	description:
		'Simple, transparent pricing for Russel. Choose between self-hosted Community, clustered Pro, and scalable Enterprise tiers.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<div class="pricing-page-wrapper">
		<!-- Page Header -->
		<section class="hero-header-section">
			<div class="section-inner">
				<span class="section-subtitle">// TRANSPARENT TIERS</span>
				<h1 class="section-title">Scale Russel on Your Own Infrastructure</h1>
				<p class="section-desc">
					Start with our fully featured Community edition on a single node, or scale up to multi-node clusters with secure state replication.
				</p>
			</div>
		</section>

		<!-- Pricing Grid -->
		<section class="pricing-grid-section">
			<div class="section-inner">
				<div class="pricing-grid">
					{pricingData.plans.map((plan) => (
						<div class:list={["pricing-card", { featured: plan.featured }]}>
							{plan.tag && <span class="card-tag">{plan.tag}</span>}
							<div class="card-header">
								<h3 class="card-title">{plan.name}</h3>
								<p class="card-tagline">{plan.tagline}</p>
							</div>
							
							<div class="card-price-section">
								<span class="currency">$</span>
								<span class="price-amount">{plan.prices.annually}</span>
								<span class="price-period">/ {plan.prices_notes.annually === 'forever' ? 'forever' : 'month'}</span>
							</div>

							<div class="card-features-list">
								<ul>
									{plan.features.map((feature) => (
										<li>
											<span class="feature-bullet">✓</span>
											<span class="feature-text">{feature}</span>
										</li>
									))}
								</ul>
							</div>

							<div class="card-actions">
								<a href={plan.cta.href} class:list={["btn", plan.featured ? "btn-primary" : "btn-secondary"]}>
									{plan.cta.label}
								</a>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Architectural Diagram -->
		<section class="diagram-section">
			<div class="section-inner">
				<span class="diagram-label">// 01 // ARCHITECTURAL SCALE COMPARISON</span>
				<div class="diagram-card">
					<div class="diagram-card-header">
						<div class="showcase-card-dots">
							<span class="showcase-dot red"></span>
							<span class="showcase-dot yellow"></span>
							<span class="showcase-dot green"></span>
						</div>
						<span class="showcase-card-title">architecture_comparison.svg</span>
					</div>
					<div class="diagram-body">
						<svg viewBox="0 0 800 240" class="arch-svg" aria-hidden="true">
							<defs>
								<marker id="arrow" markerWidth="8" markerHeight="8" refX="5" refY="2.5" orient="auto">
									<polygon points="0,0 5,2.5 0,5" fill="var(--accent)" />
								</marker>
							</defs>
							<!-- Left Box: Single-Node (Community) -->
							<rect x="20" y="30" width="340" height="180" rx="6" fill="rgba(255,255,255,0.01)" stroke="var(--border-color)" />
							<text x="190" y="55" text-anchor="middle" fill="#fff" font-family="var(--font-mono)" font-size="11" font-weight="bold">SINGLE-NODE ARCHITECTURE (Community)</text>
							
							<rect x="40" y="80" width="300" height="50" rx="4" fill="oklch(0.05 0.02 145)" stroke="var(--border-subtle)" />
							<text x="190" y="105" text-anchor="middle" fill="var(--text-color)" font-family="var(--font-mono)" font-size="10">Russel Orchestrator &amp; Nix Builder</text>
							<text x="190" y="120" text-anchor="middle" fill="var(--text-faint)" font-size="8">Runs on same machine as agent</text>
							
							<rect x="40" y="145" width="140" height="45" rx="3" fill="rgba(255,255,255,0.01)" stroke="var(--border-subtle)" />
							<text x="110" y="165" text-anchor="middle" fill="var(--text-muted)" font-size="9">Containers (Podman)</text>
							<text x="110" y="177" text-anchor="middle" fill="var(--text-faint)" font-size="7">Shared Kernel</text>
							
							<rect x="200" y="145" width="140" height="45" rx="3" fill="var(--accent-glow)" stroke="var(--accent)" />
							<text x="270" y="165" text-anchor="middle" fill="var(--accent-soft)" font-size="9">microVMs (KVM)</text>
							<text x="270" y="177" text-anchor="middle" fill="var(--text-faint)" font-size="7">Hardware Isolation</text>
							
							<!-- Divider -->
							<line x1="400" y1="20" x2="400" y2="220" stroke="var(--border-color)" stroke-dasharray="4 4" />
							
							<!-- Right Box: Multi-Node Cluster (Pro/Enterprise) -->
							<rect x="440" y="30" width="340" height="180" rx="6" fill="rgba(255,255,255,0.01)" stroke="var(--border-color)" />
							<text x="610" y="55" text-anchor="middle" fill="#fff" font-family="var(--font-mono)" font-size="11" font-weight="bold">DISTRIBUTED CLUSTER (Pro &amp; Enterprise)</text>
							
							<!-- Node A (Control Plane) -->
							<rect x="460" y="80" width="130" height="45" rx="4" fill="oklch(0.05 0.02 145)" stroke="var(--border-subtle)" />
							<text x="525" y="98" text-anchor="middle" fill="var(--text-color)" font-family="var(--font-mono)" font-size="9">Control Node A</text>
							<text x="525" y="112" text-anchor="middle" fill="var(--accent)" font-size="7.5">Raft State Consensus</text>
							
							<!-- Node B (Runner Node) -->
							<rect x="630" y="80" width="130" height="45" rx="4" fill="rgba(255,255,255,0.01)" stroke="var(--border-subtle)" />
							<text x="695" y="98" text-anchor="middle" fill="var(--text-color)" font-family="var(--font-mono)" font-size="9">Runner Node B</text>
							<text x="695" y="112" text-anchor="middle" fill="var(--text-faint)" font-size="7.5">gRPC Agent Runner</text>
							
							<!-- Node C (Runner Node) -->
							<rect x="545" y="145" width="130" height="45" rx="4" fill="rgba(255,255,255,0.01)" stroke="var(--border-subtle)" />
							<text x="610" y="163" text-anchor="middle" fill="var(--text-color)" font-family="var(--font-mono)" font-size="9">Runner Node C</text>
							<text x="610" y="177" text-anchor="middle" fill="var(--text-faint)" font-size="7.5">gRPC Agent Runner</text>
							
							<!-- Connection paths -->
							<path d="M590 102 L630 102" fill="none" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2" />
							<path d="M525 125 L545 152" fill="none" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2" />
							<path d="M695 125 L675 152" fill="none" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2" />
							
							<text x="610" y="132" text-anchor="middle" fill="var(--accent)" font-family="var(--font-mono)" font-size="8">Wireguard Mesh</text>
						</svg>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ Section -->
		<section class="faq-section">
			<div class="section-inner">
				<span class="faq-label">// 02 // BILLING &amp; DEPLOYMENT FAQ</span>
				<h2 class="faq-section-title">Frequently Asked Questions</h2>
				<div class="faq-grid">
					<div class="faq-item">
						<h4>Is the Community edition fully featured?</h4>
						<p>Yes. The Community edition includes all builders, runtimes, and local CLI tools. It is only limited to deployment on a single node host. You have complete control without any feature gating.</p>
					</div>
					<div class="faq-item">
						<h4>How do node counts work in Pro and Enterprise?</h4>
						<p>Nodes are defined as active physical or virtual host machines running the `russel-agent` runner. Our billing scales directly with the number of nodes in your Wireguard cluster network.</p>
					</div>
					<div class="faq-item">
						<h4>Can we run Russel offline / air-gapped?</h4>
						<p>Yes, the Community and Enterprise editions can run fully air-gapped. Nix package dependency stores can be pre-cached to operate completely offline.</p>
					</div>
					<div class="faq-item">
						<h4>What kind of support is included?</h4>
						<p>Community users have access to GitHub Discussions and Discord. Pro users receive priority email/chat support, while Enterprise subscribers get custom SLA commitments and direct Slack/Teams links.</p>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.pricing-page-wrapper {
		background-color: #040803;
		color: var(--text-color, oklch(0.90 0.008 145));
		font-family: var(--font-sans, 'Inter', sans-serif);
		padding: 64px 24px;
	}

	.section-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.hero-header-section {
		margin-bottom: 48px;
		text-align: left;
	}

	.section-subtitle {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 11px;
		color: var(--accent, oklch(0.65 0.15 145));
		letter-spacing: 0.1em;
		font-weight: 600;
	}

	.section-title {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: clamp(24px, 3.5vw, 42px);
		line-height: 1.15;
		font-weight: 700;
		color: #fff;
		margin: 8px 0 16px;
		letter-spacing: -0.04em;
	}

	.section-desc {
		font-size: 15px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		max-width: 680px;
		line-height: 1.6;
	}

	/* Pricing Grid */
	.pricing-grid-section {
		margin-bottom: 64px;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	@media (max-width: 992px) {
		.pricing-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 16px;
		}
	}

	@media (max-width: 600px) {
		.pricing-grid {
			grid-template-columns: 1fr;
		}
	}

	.pricing-card {
		background-color: var(--card-bg, #0a1405);
		border: 1px solid var(--border-color, oklch(0.11 0.022 145));
		border-radius: 8px;
		padding: 32px 24px;
		display: flex;
		flex-direction: column;
		position: relative;
		transition: all 0.3s ease;
	}

	.pricing-card:hover {
		border-color: var(--accent, oklch(0.65 0.15 145));
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4), 0 0 15px var(--accent-glow, oklch(0.65 0.15 145 / 0.08));
		transform: translateY(-2px);
	}

	.pricing-card.featured {
		border-color: var(--accent-alt, oklch(0.60 0.18 310));
		box-shadow: 0 0 20px var(--accent-alt-glow, oklch(0.60 0.18 310 / 0.08));
	}

	.card-tag {
		position: absolute;
		top: -12px;
		right: 24px;
		background-color: var(--accent-alt, oklch(0.60 0.18 310));
		color: #040803;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 9px;
		font-weight: 700;
		padding: 3px 8px;
		border-radius: 4px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.card-header {
		margin-bottom: 24px;
	}

	.card-title {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 18px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 6px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.card-tagline {
		font-size: 13px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		line-height: 1.4;
		margin: 0;
	}

	.card-price-section {
		display: flex;
		align-items: baseline;
		margin-bottom: 28px;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
	}

	.currency {
		font-size: 20px;
		color: var(--accent, oklch(0.65 0.15 145));
		font-weight: 500;
		margin-right: 2px;
	}

	.price-amount {
		font-size: 42px;
		font-weight: 700;
		color: #fff;
		line-height: 1;
	}

	.price-period {
		font-size: 11px;
		color: var(--text-faint, oklch(0.36 0.015 145));
		margin-left: 6px;
	}

	.card-features-list {
		flex: 1;
		margin-bottom: 32px;
	}

	.card-features-list ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.card-features-list li {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 13.5px;
	}

	.feature-bullet {
		color: var(--accent, oklch(0.65 0.15 145));
		font-weight: bold;
		flex-shrink: 0;
	}

	.pricing-card.featured .feature-bullet {
		color: var(--accent-alt, oklch(0.60 0.18 310));
	}

	.feature-text {
		color: var(--text-muted, oklch(0.58 0.020 145));
		line-height: 1.4;
	}

	.card-actions {
		margin-top: auto;
	}

	.btn {
		font-family: var(--font-sans, 'Inter', sans-serif);
		font-weight: 600;
		font-size: 12px;
		padding: 12px 24px;
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		width: 100%;
		box-sizing: border-box;
	}

	.btn-primary {
		background: rgba(237, 255, 239, 0.92);
		color: #050505;
		border: 1px solid rgba(237, 255, 239, 0.92);
	}

	.btn-primary:hover {
		background-color: transparent;
		color: var(--text-color, oklch(0.90 0.008 145));
		border-color: var(--accent, oklch(0.65 0.15 145));
	}

	.btn-secondary {
		background-color: rgba(0, 0, 0, 0.38);
		color: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(255, 255, 255, 0.38);
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
	}

	.btn-secondary:hover {
		border-color: var(--accent, oklch(0.65 0.15 145));
		color: var(--accent, oklch(0.65 0.15 145));
	}

	/* Diagram Section */
	.diagram-section {
		margin-bottom: 64px;
	}

	.diagram-label {
		display: block;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 10px;
		color: var(--text-faint, oklch(0.36 0.015 145));
		letter-spacing: 0.15em;
		margin-bottom: 12px;
	}

	.diagram-card {
		border: 1px solid var(--border-color, oklch(0.11 0.022 145));
		background-color: var(--card-bg, #0a1405);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
	}

	.diagram-card-header {
		background-color: oklch(0.05 0.020 145);
		padding: 10px 16px;
		border-bottom: 1px solid var(--border-color, oklch(0.11 0.022 145));
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.showcase-card-dots {
		display: flex;
		gap: 6px;
	}

	.showcase-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.showcase-dot.red { background-color: #ff5f56; }
	.showcase-dot.yellow { background-color: #ffbd2e; }
	.showcase-dot.green { background-color: #27c93f; }

	.showcase-card-title {
		color: var(--text-faint, oklch(0.36 0.015 145));
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 10px;
		letter-spacing: 0.05em;
	}

	.diagram-body {
		padding: 24px;
		background-color: rgba(255, 255, 255, 0.005);
	}

	.arch-svg {
		width: 100%;
		height: auto;
		display: block;
	}

	/* FAQ Section */
	.faq-section {
		margin-top: 64px;
		border-top: 1px solid var(--border-color, oklch(0.11 0.022 145));
		padding-top: 48px;
	}

	.faq-label {
		display: block;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 10px;
		color: var(--text-faint, oklch(0.36 0.015 145));
		letter-spacing: 0.15em;
		margin-bottom: 8px;
	}

	.faq-section-title {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 22px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 32px;
		letter-spacing: -0.02em;
	}

	.faq-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;
	}

	@media (max-width: 768px) {
		.faq-grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}

	.faq-item h4 {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 13.5px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 10px;
	}

	.faq-item p {
		font-size: 13px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		line-height: 1.6;
		margin: 0;
	}
</style>
