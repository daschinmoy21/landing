---
// src/pages/terms.astro
import Layout from '../layouts/Layout.astro'

const SEO = {
	title: 'Russel — Terms of Service',
	description:
		'Read the terms of service and beta participation agreements for Russel MicroVM Platform.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<div class="terms-page-wrapper">
		<!-- Page Header -->
		<section class="hero-header-section">
			<div class="section-inner">
				<span class="section-subtitle">// LEGAL FRAMEWORK</span>
				<h1 class="section-title">Terms of Service &amp; Beta Agreement</h1>
				<p class="section-desc">
					Please review the rules, guidelines, and disclaimers for using the Russel platform and participating in our private beta trial.
				</p>
			</div>
		</section>

		<!-- Main Layout -->
		<section class="content-section">
			<div class="section-inner content-grid">
				<!-- Sidebar Table of Contents -->
				<aside class="terms-sidebar">
					<div class="sidebar-sticky">
						<span class="sidebar-title">// SECTIONS</span>
						<nav class="sidebar-nav">
							<a href="#overview" class="sidebar-link">1. Agreement Overview</a>
							<a href="#license" class="sidebar-link">2. Open Source &amp; License</a>
							<a href="#usage" class="sidebar-link">3. Acceptable Use Policy</a>
							<a href="#beta" class="sidebar-link">4. Beta Program Specifics</a>
							<a href="#liability" class="sidebar-link">5. Disclaimers &amp; Liability</a>
						</nav>
					</div>
				</aside>

				<!-- Terms Content -->
				<main class="terms-body">
					<!-- Section 1 -->
					<article id="overview" class="terms-article">
						<h3>1. Agreement Overview</h3>
						<p>
							Welcome to Russel. Russel is a self-hosted microVM and container deployment orchestrator developed by our contributors. By accessing or deploying our software, including participating in the Russel private beta, you agree to comply with and be bound by these Terms of Service.
						</p>
						<p>
							We recommend reviewing these terms regularly as we continue to update the software, compile new releases, and expand the orchestration features. Your continued use of the platform constitutes an active acceptance of any updated terms.
						</p>
					</article>

					<!-- Section 2 -->
					<article id="license" class="terms-article">
						<h3>2. Open Source &amp; License</h3>
						<p>
							Russel is designed with open-source principles. When publicly released, the core codebase will be licensed under the permissive MIT license.
						</p>
						<p>
							During the private beta phase, access to pre-release binaries, documentation, and specific orchestration modules is granted solely to registered beta participants. You may not distribute, relicense, or reverse-engineer pre-release binary components unless explicitly authorized under separate terms by the contributors.
						</p>
					</article>

					<!-- Section 3 -->
					<article id="usage" class="terms-article">
						<h3>3. Acceptable Use Policy</h3>
						<p>
							When deploying Russel, you are solely responsible for compliance with local and international laws. Specifically, you agree not to use Russel to host, compile, or distribute:
						</p>
						<ul class="custom-bullet-list">
							<li>Malicious software, cryptojackers, or denial-of-service tools.</li>
							<li>Unlicensed or copyrighted material without appropriate permissions.</li>
							<li>Applications designed to breach or compromise third-party cloud infrastructure.</li>
						</ul>
						<p>
							Failure to comply with acceptable use guidelines will result in immediate termination of your beta account, revocation of gRPC registration keys, and restriction from future releases.
						</p>
					</article>

					<!-- Section 4 -->
					<article id="beta" class="terms-article">
						<h3>4. Beta Program Specifics</h3>
						<p>
							Russel's current releases are pre-production beta software. You acknowledge that features, configuration files (such as <code>Russelfile.toml</code>), APIs, and command line tools may change, break, or be deprecated at any time.
						</p>
						<p>
							We strongly advise against running mission-critical enterprise production workloads on private beta releases. Data loss, VM state crashes, and network routing interruptions are possible as we harden KVM and virtiofs configurations.
						</p>
					</article>

					<!-- Section 5 -->
					<article id="liability" class="terms-article">
						<h3>5. Disclaimers &amp; Liability</h3>
						<p>
							RUSSEL IS PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.
						</p>
						<p>
							IN NO EVENT SHALL THE CONTRIBUTORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES, OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT, OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
						</p>
					</article>
				</main>
			</div>
		</section>
	</div>
</Layout>

<style>
	.terms-page-wrapper {
		background-color: #040803;
		color: var(--text-color, oklch(0.90 0.008 145));
		font-family: var(--font-sans, 'Inter', sans-serif);
		padding: 64px 24px;
	}

	.section-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.hero-header-section {
		margin-bottom: 48px;
		text-align: left;
	}

	.section-subtitle {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 11px;
		color: var(--accent, oklch(0.65 0.15 145));
		letter-spacing: 0.1em;
		font-weight: 600;
	}

	.section-title {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: clamp(24px, 3.5vw, 42px);
		line-height: 1.15;
		font-weight: 700;
		color: #fff;
		margin: 8px 0 16px;
		letter-spacing: -0.04em;
	}

	.section-desc {
		font-size: 15px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		max-width: 680px;
		line-height: 1.6;
	}

	/* Two-column layout */
	.content-section {
		border-top: 1px solid var(--border-color, oklch(0.11 0.022 145));
		padding-top: 48px;
	}

	.content-grid {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: 48px;
		align-items: start;
	}

	@media (max-width: 768px) {
		.content-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}

	/* Sidebar styling */
	.terms-sidebar {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
	}

	.sidebar-sticky {
		position: sticky;
		top: 120px;
	}

	.sidebar-title {
		display: block;
		font-size: 10px;
		color: var(--text-faint, oklch(0.36 0.015 145));
		letter-spacing: 0.15em;
		margin-bottom: 16px;
		font-weight: 600;
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.sidebar-link {
		color: var(--text-muted, oklch(0.58 0.020 145));
		text-decoration: none;
		font-size: 12px;
		transition: color 0.2s ease;
	}

	.sidebar-link:hover {
		color: var(--accent, oklch(0.65 0.15 145));
	}

	/* Body styling */
	.terms-body {
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.terms-article {
		border-bottom: 1px solid var(--border-subtle, oklch(0.08 0.015 145));
		padding-bottom: 32px;
	}

	.terms-article:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.terms-article h3 {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 16px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 16px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.terms-article p {
		font-size: 14.5px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		line-height: 1.7;
		margin-bottom: 16px;
	}

	.terms-article p code {
		background-color: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-subtle, oklch(0.08 0.015 145));
		padding: 2px 6px;
		border-radius: 4px;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 12px;
		color: var(--accent, oklch(0.65 0.15 145));
	}

	.custom-bullet-list {
		list-style: none;
		padding: 0;
		margin: 0 0 24px 0;
	}

	.custom-bullet-list li {
		position: relative;
		padding-left: 20px;
		margin-bottom: 10px;
		font-size: 14px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		line-height: 1.6;
	}

	.custom-bullet-list li::before {
		content: "•";
		position: absolute;
		left: 0;
		color: var(--accent, oklch(0.65 0.15 145));
		font-weight: bold;
	}
</style>
