---
// src/pages/features.astro
import Layout from '../layouts/Layout.astro'
import PipelineCircuitBoard from '../components/ui/PipelineCircuitBoard.jsx'

const SEO = {
	title: 'Russel — Features & Capabilities',
	description:
		'Explore Russel\'s technical engine architecture, zero-drift reproducible builds, and dual runtime environment supporting containers and hardware-isolated microVMs.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<div class="features-page-wrapper">
		<!-- Section Header -->
		<section class="hero-header-section">
			<div class="section-inner">
				<span class="section-subtitle">// ENGINE CAPABILITIES</span>
				<h1 class="section-title">Zero-Drift Builds & Hardware-Isolated Virtualization</h1>
				<p class="section-desc">
					Russel combines the speed and flexibility of container development workflows with the robust, hardware-level security guarantees of microVM sandboxes.
				</p>
			</div>
		</section>

		<!-- Build and Deploy Pipeline Diagram -->
		<section class="diagram-section">
			<div class="section-inner">
				<span class="diagram-label">// 01 // DEPLOYMENT PIPELINE FLOW</span>
				<div class="diagram-card">
					<div class="diagram-card-header">
						<div class="showcase-card-dots">
							<span class="showcase-dot red"></span>
							<span class="showcase-dot yellow"></span>
							<span class="showcase-dot green"></span>
						</div>
						<span class="showcase-card-title">deployment_pipeline.svg</span>
					</div>
					<div class="diagram-body">
						<PipelineCircuitBoard client:only="react" />
					</div>
				</div>
			</div>
		</section>

		<!-- Features Grid -->
		<section class="features-grid-section">
			<div class="section-inner">
				<span class="grid-section-label">// 02 // PLATFORM CAPABILITIES SUMMARY</span>
				<div class="features-grid">
					<!-- Card 1 -->
					<div class="feature-card">
						<div class="card-icon">01</div>
						<h3 class="card-title">Dual-Engine Orchestration</h3>
						<p class="card-desc">
							Run standard container engines for rapid local iteration, then promote the exact same config file to hardware-isolated KVM microVMs for strict production isolation with zero code changes.
						</p>
					</div>

					<!-- Card 2 -->
					<div class="feature-card">
						<div class="card-icon">02</div>
						<h3 class="card-title">Deterministic Nix Builds</h3>
						<p class="card-desc">
							Say goodbye to environment drift. Russel compiles source packages in sandboxed, content-addressed Nix builds. The bits that execute on your local box match your production cluster byte-for-byte.
						</p>
					</div>

					<!-- Card 3 -->
					<div class="feature-card">
						<div class="card-icon">03</div>
						<h3 class="card-title">Sub-2 Second Boot Times</h3>
						<p class="card-desc">
							Using custom-tailored Linux kernels (2MB initramfs) and KVM virtualization, Russel spins up fully virtualized hardware-isolated sandboxes in less than two seconds.
						</p>
					</div>

					<!-- Card 4 -->
					<div class="feature-card">
						<div class="card-icon">04</div>
						<h3 class="card-title">Instant Hot-Swaps</h3>
						<p class="card-desc">
							Switch runtimes instantly. A single parameter change in `Russelfile.toml` pivots your instance from container to microVM. The scheduler handles port re-routing and swaps with zero downtime.
						</p>
					</div>

					<!-- Card 5 -->
					<div class="feature-card">
						<div class="card-icon">05</div>
						<h3 class="card-title">CVE Dependency Promotor</h3>
						<p class="card-desc">
							Continuous scanning integration. Build pipelines automatically parse package dependencies. If vulnerable packages are flagged, the instance is automatically promoted to run in a microVM.
						</p>
					</div>

					<!-- Card 6 -->
					<div class="feature-card">
						<div class="card-icon">06</div>
						<h3 class="card-title">Zero Daemon Bloat</h3>
						<p class="card-desc">
							Built with Rust. No resident bulky Docker daemon eating gigabytes of RAM. The node runner `russel-agent` communicating via gRPC leverages Linux sockets directly to maximize host density.
						</p>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.features-page-wrapper {
		background-color: #040803;
		color: var(--text-color, oklch(0.90 0.008 145));
		font-family: var(--font-sans, 'Inter', sans-serif);
		padding: 64px 24px;
	}

	.section-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.hero-header-section {
		margin-bottom: 48px;
		text-align: left;
	}

	.section-subtitle {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 11px;
		color: var(--accent, oklch(0.65 0.15 145));
		letter-spacing: 0.1em;
		font-weight: 600;
	}

	.section-title {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: clamp(24px, 3.5vw, 42px);
		line-height: 1.15;
		font-weight: 700;
		color: #fff;
		margin: 8px 0 16px;
		letter-spacing: -0.04em;
	}

	.section-desc {
		font-size: 15px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		max-width: 680px;
		line-height: 1.6;
	}

	/* Diagram section */
	.diagram-section {
		margin-bottom: 64px;
	}

	.diagram-label {
		display: block;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 10px;
		color: var(--text-faint, oklch(0.36 0.015 145));
		letter-spacing: 0.15em;
		margin-bottom: 12px;
	}

	.diagram-card {
		border: 1px solid var(--border-color, oklch(0.11 0.022 145));
		background-color: var(--card-bg, #0a1405);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
	}

	.diagram-card-header {
		background-color: oklch(0.05 0.020 145);
		padding: 10px 16px;
		border-bottom: 1px solid var(--border-color, oklch(0.11 0.022 145));
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.showcase-card-dots {
		display: flex;
		gap: 6px;
	}

	.showcase-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.showcase-dot.red { background-color: #ff5f56; }
	.showcase-dot.yellow { background-color: #ffbd2e; }
	.showcase-dot.green { background-color: #27c93f; }

	.showcase-card-title {
		color: var(--text-faint, oklch(0.36 0.015 145));
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 10px;
		letter-spacing: 0.05em;
	}

	.diagram-body {
		padding: 24px;
		background-color: rgba(255, 255, 255, 0.005);
	}

	.pipeline-svg {
		width: 100%;
		height: auto;
		display: block;
	}

	/* Grid section */
	.features-grid-section {
		margin-top: 64px;
	}

	.grid-section-label {
		display: block;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 10px;
		color: var(--text-faint, oklch(0.36 0.015 145));
		letter-spacing: 0.15em;
		margin-bottom: 24px;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	@media (max-width: 992px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.features-grid {
			grid-template-columns: 1fr;
		}
	}

	.feature-card {
		background-color: var(--card-bg, #0a1405);
		border: 1px solid var(--border-color, oklch(0.11 0.022 145));
		border-radius: 8px;
		padding: 24px;
		transition: all 0.3s ease;
	}

	.feature-card:hover {
		border-color: var(--accent, oklch(0.65 0.15 145));
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4), 0 0 15px var(--accent-glow, oklch(0.65 0.15 145 / 0.08));
		transform: translateY(-2px);
	}

	.card-icon {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 11px;
		color: var(--accent, oklch(0.65 0.15 145));
		background-color: rgba(255,255,255,0.02);
		border: 1px solid var(--border-subtle, oklch(0.08 0.015 145));
		padding: 4px 8px;
		width: fit-content;
		border-radius: 4px;
		margin-bottom: 16px;
	}

	.card-title {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 14px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 10px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.card-desc {
		font-size: 13px;
		color: var(--text-muted, oklch(0.58 0.020 145));
		line-height: 1.6;
		margin: 0;
	}
</style>
