---
// 404 Page
// ------------
// Description: The 404 page is a page that displays when a page is not found.

// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - Blocks
import BasicHeroSplitImageCTA from '../components/blocks/hero/BasicHeroSplitImageCTA.astro'

// Content
// - Images
import image from '../assets/404.webp'
// - SEO
const SEO = {
	title: 'Error 404: VM Not Found',
	description:
		'The page or host container you are trying to dispatch to does not exist or has been terminated.'
}
// - Hero data
const heroData = {
	title: 'Error 404: VM Not Found',
	subtitle: 'routing error',
	text: 'The page or host container you are trying to dispatch to does not exist or has been terminated. Let\'s return to the supervisor node.',
	image: image,
	buttonText: 'Back to supervisor',
	buttonLink: '/'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<BasicHeroSplitImageCTA
		subtitle={heroData.subtitle}
		title={heroData.title}
		text={heroData.text}
		image={heroData.image}
		buttonText={heroData.buttonText}
		buttonLink={heroData.buttonLink}
	/>
</Layout>
