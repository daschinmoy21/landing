---
// NavigationBar.astro
// Description: Split-screen header with logo and navigation menu for Russel microVM Platform

const path = new URL(Astro.request.url).pathname
const isHome = path === '/' || path === ''
---

<header class="main-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <svg viewBox="0 0 32 32" aria-hidden="true" class="logo-svg">
        <rect
          x="2"
          y="2"
          width="28"
          height="28"
          rx="7"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        />
        <rect x="12" y="12" width="8" height="8" rx="1.5" class="pulse" />
        <path
          d="M16 2v6M16 24v6M2 16h6M24 16h6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
      <span class="brand-name">Russel</span>
    </a>
  </div>
</header>

<style>
  .main-header {
    position: sticky;
    top: 0;
    background-color: rgba(4, 8, 3, 0.85);
    backdrop-filter: blur(12px);
    z-index: 100;
    border-bottom: 1px solid var(--border-color, oklch(0.11 0.022 145));
    width: 100%;
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
    height: 52px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 992px) {
    .header-inner {
      padding: 0 24px;
    }
  }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 24px;
      height: 48px;
    }
  }

  /* Brand / Logo (Left) */
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-color, oklch(0.90 0.008 145));
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.03em;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .brand:hover,
  .brand:focus-visible {
    color: var(--text-color, oklch(0.90 0.008 145));
    opacity: 0.85;
  }

  .brand-name {
    color: inherit;
  }

  .logo-svg {
    width: 20px;
    height: 20px;
    color: var(--text-color, oklch(0.90 0.008 145));
  }

  .brand .pulse {
    fill: var(--accent, oklch(0.65 0.15 145));
  }

  /* Navigation Links (Right) */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  @media (max-width: 640px) {
    .nav-links {
      gap: 8px;
    }
  }

  .nav-link {
    color: var(--text-muted, oklch(0.58 0.020 145));
    text-decoration: none;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid transparent;
  }

  .nav-link:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.02);
  }
</style>
