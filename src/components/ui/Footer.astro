---
// Footer.astro
// Description: Unified footer for Russel microVM Platform

const path = new URL(Astro.request.url).pathname
const isHome = path === '/' || path === ''
---

<footer class="footer-section">
  <div class="footer-inner">
    <div class="footer-bottom">
      <div class="footer-left">
        <span class="copyright">&copy; 2026 Russel contributors. MIT Private Beta.</span>
      </div>
      <div class="footer-nav">
        <a href={isHome ? "#top" : "/#top"} class="footer-link">Overview</a>
        <span class="footer-separator">|</span>
        <a href={isHome ? "#features" : "/#features"} class="footer-link">Features</a>
        <span class="footer-separator">|</span>
        <a href={isHome ? "#comparison" : "/#comparison"} class="footer-link">Benchmarks</a>
        <span class="footer-separator">|</span>
        <a href={isHome ? "#architecture" : "/#architecture"} class="footer-link">Architecture</a>
        <span class="footer-separator">|</span>
        <a href={isHome ? "#roadmap" : "/#roadmap"} class="footer-link">Roadmap</a>
        <span class="footer-separator">|</span>
        <a href="/pricing" class="footer-link">Pricing</a>
        <span class="footer-separator">|</span>
        <a href="/contact" class="footer-link">Contact</a>
        <span class="footer-separator">|</span>
        <a href="/blog" class="footer-link">Blog</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    border-top: 1px solid var(--border-color, oklch(0.11 0.022 145));
    background-color: #040803;
    padding: 32px 0;
    width: 100%;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 48px;
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 0 24px;
    }
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    color: var(--text-faint, oklch(0.36 0.015 145));
  }

  @media (max-width: 992px) {
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }

  .copyright {
    letter-spacing: 0.05em;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    align-items: center;
  }

  .footer-link {
    color: var(--text-muted, oklch(0.58 0.020 145));
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent, oklch(0.65 0.15 145));
  }

  .footer-separator {
    color: var(--border-color, oklch(0.11 0.022 145));
  }
</style>
